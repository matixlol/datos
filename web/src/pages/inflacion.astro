---
import Base from "../layouts/Base.astro";
import { dichos, ipcMensual, MES, MES3, mayus, nombreMes, pct, type Dicho } from "../data/inflacion";

const ipc = await ipcMensual();
const porMes = new Map(ipc);
const [ultMes, ultVal] = ipc[ipc.length - 1];

// quotes by the month they were said; promises by the month they were for
const dichosEn = new Map<string, Dicho[]>();
const metas = new Map<string, Dicho[]>();
for (const d of dichos) {
  const m = d.fecha.slice(0, 7);
  dichosEn.set(m, [...(dichosEn.get(m) ?? []), d]);
  if (d.objetivo && !d.broma) metas.set(d.objetivo, [...(metas.get(d.objetivo) ?? []), d]);
}

// "el 13 y el 25 de junio de 2025", "el 17 de diciembre de 2025 y el 16 y el 19 de marzo de 2026"
const y = (xs: string[]) => (xs.length > 1 ? xs.slice(0, -1).join(", ") + " y " + xs.at(-1) : xs[0]);
const fechas = (isos: string[]) => {
  const grupos = new Map<string, string[]>();
  for (const f of [...new Set(isos)].sort()) grupos.set(f.slice(0, 7), [...(grupos.get(f.slice(0, 7)) ?? []), "el " + +f.slice(8)]);
  return y([...grupos].map(([k, ds]) => `${y(ds)} de ${nombreMes(k)}`));
};
const diaMes = (iso: string) => `${+iso.slice(8)} de ${MES[+iso.slice(5, 7) - 1]} de ${iso.slice(0, 4)}`;

// newest first
const filas = [...ipc].reverse().map(([ym, v]) => {
  const clave = metas.has(ym) || dichosEn.has(ym);
  return { ym, v, clave, meta: metas.get(ym), dichos: dichosEn.get(ym) ?? [] };
});
---
<Base>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=Familjen+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
  </Fragment>
  <main>
    <header>
      <h1>¿La inflación ya empieza con cero?</h1>
      <p class="no">{ultVal < 1 ? "Sí." : "No."}</p>
      <p class="ultimo">{mayus(MES[+ultMes.slice(5) - 1])}: <b>{pct(ultVal)}</b>.</p>
    </header>

    <ol id="linea">
      {filas.map((f) => (
        <li class:list={["fila", { quieta: !f.clave, meta: !!f.meta }]} id={`m-${f.ym}`}>
          <div class="mes">{MES3[+f.ym.slice(5) - 1]}<small>{f.ym.slice(0, 4)}</small></div>
          <div class="val" aria-label={`Inflación de ${nombreMes(f.ym)}: ${pct(f.v)}`}>{pct(f.v)}</div>
          <div class="dichos">
            {f.meta && (
              <div class="aviso">
                Acá tenía que empezar con cero.
                <small>Lo dijo {fechas(f.meta.map((d) => d.fecha))}.</small>
              </div>
            )}
            {f.dichos.map((d) => (
              <div class:list={["dicho", { principal: d.principal }]}>
                <blockquote>«{d.cita}»</blockquote>
                <p>
                  {diaMes(d.fecha)}, {d.lugar}.{" "}
                  {d.objetivo && !d.broma && <><a class="para" href={`#m-${d.objetivo}`}>Para {nombreMes(d.objetivo)}.</a>{" "}</>}
                  {d.nota && <>{d.nota}{" "}</>}
                  {d.contra && porMes.has(d.contra) && <>La minorista de {MES[+d.contra.slice(5) - 1]} fue {pct(porMes.get(d.contra)!)}.{" "}</>}
                  <a href={d.fuente}>Fuente</a>
                </p>
              </div>
            ))}
          </div>
        </li>
      ))}
    </ol>

    <footer>
      <p>Inflación mensual: INDEC, índice de precios al consumidor, nivel general. Citas: discursos oficiales publicados por la <a href="https://www.casarosada.gob.ar/informacion/discursos">Casa Rosada</a>, salvo la del stream, tomada de <a href="https://www.minutouno.com/politica/javier-milei-le-puso-fecha-la-inflacion-cero-coma-algo-n6225413">MinutoUno</a>.</p>
      <p>Último dato: {nombreMes(ultMes)}. Se actualiza cuando el INDEC publica el de cada mes.</p>
    </footer>
  </main>
</Base>

<style is:global>
:root {
  --fondo: #F3F3F1; --tinta: #15171C; --gris: #5E626B; --linea: #DCDDD9;
  --celeste: #2F7DC4; --zona: #DCEAF7;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --fondo: #121419; --tinta: #EEEFF2; --gris: #A4A8B1; --linea: #262A32;
    --celeste: #6FB0EA; --zona: #1C2C3E;
  }
}
:root[data-theme="dark"] {
  --fondo: #121419; --tinta: #EEEFF2; --gris: #A4A8B1; --linea: #262A32;
  --celeste: #6FB0EA; --zona: #1C2C3E;
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
@media (prefers-reduced-motion: no-preference) {
  html { scroll-behavior: smooth; }
  .fila:target { animation: llegada 2.4s ease-out; }
}
@keyframes llegada { from { background: var(--zona); } to { background: transparent; } }
.fila { scroll-margin-top: 24px; }
body { margin: 0; background: var(--fondo); color: var(--tinta); font: 17px/1.5 "Familjen Grotesk", system-ui, sans-serif; font-variant-numeric: tabular-nums; }
main { max-width: 1240px; margin: 0 auto; padding: 0 16px 96px; display: grid; grid-template-columns: minmax(280px, 0.8fr) 1.6fr; column-gap: 56px; align-items: start; }
#linea, footer { grid-column: 2; }
#linea { padding: 40px 0 0; margin: 0; list-style: none; }
h1, p, blockquote { margin: 0; }
a { color: inherit; text-underline-offset: 3px; }
a:focus-visible { outline: 2px solid var(--celeste); outline-offset: 2px; }

header { position: sticky; top: 0; padding: 40px 0; }
h1 { font-family: "Bricolage Grotesque", sans-serif; font-weight: 600; font-size: clamp(24px, 4vw, 36px); line-height: 1.1; letter-spacing: -0.01em; }
.no { font-family: "Bricolage Grotesque", sans-serif; font-weight: 800; font-size: clamp(120px, 16vw, 230px); line-height: 0.8; letter-spacing: -0.05em; margin: 18px 0 0 -0.04em; }
.ultimo { margin-top: 24px; font-family: "Bricolage Grotesque", sans-serif; font-weight: 500; font-size: clamp(24px, 3.6vw, 34px); line-height: 1.15; }
.ultimo b { font-weight: 800; }

.fila { display: grid; grid-template-columns: 80px 88px 1fr; column-gap: 24px; align-items: baseline; border-top: 1px solid var(--linea); padding: 18px 0; }
.mes { font-weight: 600; font-size: 16px; line-height: 1.2; }
.mes small { font-weight: 400; color: var(--gris); margin-left: 4px; }
.val { font-family: "Bricolage Grotesque", sans-serif; font-weight: 800; font-size: 32px; line-height: 1; letter-spacing: -0.02em; text-align: right; }
.dichos { display: grid; gap: 14px; }
.fila.quieta { padding: 3px 0; border-top: 1px dotted var(--linea); }
.fila.quieta .mes { font-weight: 400; font-size: 14px; color: var(--gris); }
.fila.quieta .val { font-size: 15px; font-weight: 600; letter-spacing: 0; }
.fila.quieta + .fila:not(.quieta) { margin-top: 6px; }
.meta { border-top: 2px solid var(--celeste); }
.meta .val { color: var(--celeste); }
.aviso { font-family: "Bricolage Grotesque", sans-serif; font-weight: 700; font-size: 19px; line-height: 1.2; color: var(--celeste); }
.aviso small { display: block; margin-top: 2px; font-family: "Familjen Grotesk", sans-serif; font-weight: 400; font-size: 14px; color: var(--gris); }

blockquote { font-family: "Bricolage Grotesque", sans-serif; font-weight: 500; font-size: 19px; line-height: 1.3; max-width: 44ch; }
.principal blockquote { font-size: 24px; font-weight: 600; }
.dicho p { margin-top: 4px; font-size: 14px; color: var(--gris); }
.dicho p a { color: var(--gris); }
.dicho .para { color: var(--celeste); font-weight: 600; text-decoration: none; }
.dicho .para:hover { text-decoration: underline; }

@media (max-width: 900px) {
  main { display: block; max-width: 1000px; }
  header { position: static; padding: 32px 0 8px; display: grid; grid-template-columns: auto 1fr; column-gap: 24px; align-items: end; }
  header h1 { grid-column: 1 / -1; }
  .no { font-size: clamp(90px, 22vw, 150px); margin-top: 10px; }
  .ultimo { margin: 0 0 8px; }
  #linea { padding-top: 24px; }
}
@media (max-width: 680px) {
  .fila { grid-template-columns: 76px 84px 1fr; column-gap: 14px; row-gap: 12px; }
  .val { font-size: 28px; }
  .dichos { grid-column: 1 / -1; }
  .quieta .dichos { display: none; }
}

footer { margin-top: 72px; padding-top: 18px; border-top: 2px solid var(--tinta); color: var(--gris); font-size: 15px; max-width: 70ch; }
footer p + p { margin-top: 8px; }
</style>
