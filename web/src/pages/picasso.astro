---
// ¿Lo dijo Picasso? Built from the radar's sites/citas prototype (private
// repo); citas.json is its dist/citas.json, already sorted for display.
import Base from "../layouts/Base.astro";
import C from "../data/picasso/citas.json";
---
<Base>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=Familjen+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
  </Fragment>
<main>
<header>
  <h1>¿Lo dijo Picasso?</h1>
  <p class="no">No.</p>
  <p class="titular" id="titular"></p>
  <div class="filtros" id="filtros" role="group" aria-label="Filtrar por veredicto"></div>
</header>
<ol id="lista"></ol>
<footer>
  <h2>Cómo lo contamos</h2>
  <p>Leímos las 247 transcripciones oficiales de discursos de Milei publicadas en casarosada.gob.ar, del 10 de diciembre de 2023 al 18 de noviembre de 2026. Cuenta como cita cuando nombra a alguien famoso fuera de la política argentina actual y le pone en la boca una frase concreta. No cuentan las ideas resumidas, las anécdotas, la Biblia ni la Constitución, salvo el rey Salomón, porque la prensa la señaló como cita apócrifa.</p>
  <p>Cada frase se buscó en la obra original, Wikiquote, Quote Investigator y chequeos de Chequeado. «No la dijo» quiere decir que la frase es de otra persona o inventada. «Sin rastro» quiere decir que no encontramos dónde la dijo, pero no está probado que sea falsa, y no la contamos como falsa.</p>
  <p>Lo que no podemos afirmar: que Milei las invente (casi todas circulan en internet desde antes), ni que cubrimos todo lo que dice: entrevistas, actos y posteos no están en las transcripciones oficiales.</p>
</footer>
</main>
<dialog id="dialogo" aria-label="Compartir">
  <div class="tabs" role="tablist">
    <button role="tab" data-formato="ig" aria-selected="true">Instagram<small>4:5</small></button>
    <button role="tab" data-formato="x" aria-selected="false">X<small>16:9</small></button>
  </div>
  <img id="tarjeta" alt="">
  <div class="acciones">
    <button class="secundario" id="cerrar" type="button">Cerrar</button>
    <button class="principal" id="bajar" type="button">Compartir</button>
  </div>
</dialog>
</Base>

<script is:inline define:vars={{ C }}>
const $ = (id) => document.getElementById(id);
const MES = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"];
const fecha = (iso) => `${+iso.slice(8)} ${MES[+iso.slice(5, 7) - 1]} ${iso.slice(0, 4)}`;
const CLASE = { "no la dijo": "v-no", "sin rastro": "v-sin", "parecida": "v-par", "la dijo": "v-si" };
const ETIQUETA = { "no la dijo": "No la dijo", "sin rastro": "Sin rastro", "parecida": "Parecida", "la dijo": "La dijo" };
const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

const total = C.length, nunca = C.filter((c) => c.veredicto === "no la dijo");
const usosNunca = nunca.reduce((n, c) => n + c.usos.length, 0);
const picasso = C.find((c) => c.id === "picasso");
const resumen = `${nunca.length} de ${total} frases de famosos que Milei citó en discursos oficiales no las dijo quien él dice.`;
$("titular").innerHTML = `<b>${nunca.length} de ${total}</b> frases de famosos que Milei citó en discursos oficiales no las dijo quien él dice. Las usó ${usosNunca} veces. La de Picasso, ${picasso.usos.length}.`;

let filtro = "todas";
const opciones = [["todas", "Todas", total], ...Object.keys(ETIQUETA).map((v) => [v, ETIQUETA[v], C.filter((c) => c.veredicto === v).length])];
function pintar() {
  $("filtros").replaceChildren(...opciones.map(([v, t, n]) => {
    const b = document.createElement("button");
    b.setAttribute("aria-pressed", v === filtro);
    b.innerHTML = `${t}<b>${n}</b>`;
    b.onclick = () => { filtro = v; pintar(); };
    return b;
  }));
  $("lista").replaceChildren(...C.filter((c) => filtro === "todas" || c.veredicto === filtro).map((c) => {
    const li = document.createElement("li");
    li.id = c.id;
    li.className = "cita" + (c.id === "picasso" ? " picasso" : "");
    const n = c.usos.length;
    li.innerHTML = `<blockquote>«${esc(c.frase)}»</blockquote>
      <p class="quien">Según Milei, de <b>${esc(c.autor)}</b>. ${n === 1 ? "La usó 1 vez." : `La usó ${n} veces.`}</p>
      <div class="fila"><p class="veredicto ${CLASE[c.veredicto]}">${ETIQUETA[c.veredicto]}</p><button class="compartir" type="button">Compartir</button></div>
      <p class="explica">${esc(c.explicacion)} <a href="${esc(c.fuente)}" rel="noopener">Fuente</a></p>
      ${c.origen ? `<div class="origen">${c.origen.imagen ? `<a href="${esc(c.origen.url)}" rel="noopener"><img src="${c.origen.imagen}" alt="La frase como circula en internet" loading="lazy"></a>` : ""}<p><b>De dónde lo sacó.</b> ${esc(c.origen.texto)} <a href="${esc(c.origen.url)}" rel="noopener">Ver</a></p></div>` : ""}
      <p class="usos">${c.usos.map((u) => `<a href="${esc(u.url)}" rel="noopener">${fecha(u.fecha)}</a>`).join("")}</p>`;
    li.querySelector(".compartir").onclick = () => abrir(c);
    return li;
  }));
}
pintar();

// share card: one quote, drawn on a canvas, always in the light palette
const FORMATOS = { ig: [1080, 1350], x: [1200, 675] };
const MESES = "enero febrero marzo abril mayo junio julio agosto septiembre octubre noviembre diciembre".split(" ");
const COLOR = { "no la dijo": "#C2410C", "sin rastro": "#A16207", "parecida": "#A16207", "la dijo": "#3F6212" };
let formato = "ig", cita = null, tarjetaBlob = null;
function lineas(g, t, ancho) {
  const out = [];
  let l = "";
  for (const p of t.split(" ")) {
    const prueba = l ? l + " " + p : p;
    if (l && g.measureText(prueba).width > ancho) { out.push(l); l = p; } else l = prueba;
  }
  return out.concat(l);
}
async function dibujar() {
  const [W, H] = FORMATOS[formato];
  await Promise.all(["800 100px 'Bricolage Grotesque'", "700 100px 'Bricolage Grotesque'", "600 40px 'Bricolage Grotesque'", "500 30px 'Familjen Grotesk'", "600 30px 'Familjen Grotesk'"].map((f) => document.fonts.load(f)));
  // same design as the page's Open Graph image; laid out at W×H, rasterized at 2×
  const c = document.createElement("canvas"); c.width = W * 2; c.height = H * 2;
  const g = c.getContext("2d");
  g.scale(2, 2);
  const TINTA = "#15171C", GRIS = "#454950";
  g.fillStyle = "#F3F3F1"; g.fillRect(0, 0, W, H);
  g.textBaseline = "alphabetic";
  const ig = formato === "ig";
  const pad = ig ? 80 : 64, ancho = W - 2 * pad;
  const texto = (t, x, y, font, color) => { g.font = font; g.fillStyle = color; g.fillText(t, x, y); return g.measureText(t).width; };
  const mide = (t, font) => { g.font = font; return g.measureText(t).width; };
  const col = COLOR[cita.veredicto], falsa = cita.veredicto === "no la dijo";

  // header
  const u = cita.usos[cita.usos.length - 1].fecha;
  const cuando = cita.usos.length === 1 ? `Milei, el ${+u.slice(8)} de ${MESES[+u.slice(5, 7) - 1]} de ${u.slice(0, 4)}:` : `Milei, en ${cita.usos.length} discursos oficiales:`;
  const fCab = `600 ${ig ? 36 : 28}px 'Familjen Grotesk'`;

  // quote, as large as fits its box
  const cajaQ = ig ? 740 : 200;
  let tam = ig ? 124 : 64, ls;
  for (; tam > 28; tam -= 2) {
    g.font = `700 ${tam}px 'Bricolage Grotesque'`;
    ls = lineas(g, `«${cita.frase}»`, ancho);
    if (ls.length * tam * 1.06 <= cajaQ) break;
  }

  // attribution row: — Author (crossed out when false)  Verdict.
  const tA = ig ? 64 : 46;
  const fAut = `600 ${tA}px 'Bricolage Grotesque'`, fVer = `800 ${tA}px 'Bricolage Grotesque'`;
  const veredicto = falsa ? "Nunca la dijo." : `${ETIQUETA[cita.veredicto]}.`;
  const wAut = mide(`— ${cita.autor}`, fAut), wVer = mide(veredicto, fVer);
  const dosFilas = wAut + 24 + wVer > ancho;

  // box: where it came from, or what we found
  const fCaja = `500 ${ig ? 36 : 24}px 'Familjen Grotesk'`, fRot = `600 ${ig ? 36 : 24}px 'Familjen Grotesk'`, lhC = ig ? 48 : 32, pC = ig ? 32 : 20;
  g.font = fCaja;
  const cuerpo = lineas(g, cita.origen ? cita.origen.texto : cita.explicacion, ancho - 2 * pC).slice(0, ig ? 6 : 3);
  const rotulo = cita.origen ? "De dónde lo sacó." : { "la dijo": "Dónde la dijo.", "parecida": "Qué dijo en realidad.", "sin rastro": "Qué encontramos.", "no la dijo": "Por qué no." }[cita.veredicto];
  const altoCaja = 2 * pC + (cuerpo.length + 1) * lhC - (lhC - (ig ? 36 : 24));

  // bottom band (X draws its own label over the bottom-left, so ours sits on the right)
  const banda = ig ? 150 : 96;
  const nota = falsa ? `Y no es la única: ${nunca.length} de ${total} frases de famosos.` : `${nunca.length} de ${total} frases de famosos que citó no son de quien él dice.`;

  // vertical layout: top block, box and bottom band spread like the OG (space-between)
  const altoArriba = (ig ? 36 : 28) + (ig ? 22 : 14) + ls.length * tam * 1.06 + (ig ? 30 : 20) + tA * (dosFilas ? 2.15 : 1);
  const top = ig ? 80 : 52;
  // X: spread like the OG. Instagram is tall, so gaps are capped and the group is centered above the band.
  const libre = H - top - altoArriba - altoCaja - banda;
  const hueco = ig ? Math.max(48, Math.min(80, libre / 2)) : Math.max(20, libre / 2);
  const corrida = ig ? Math.max(0, (libre - 2 * hueco) / 2) : 0;

  let y = top + corrida + (ig ? 30 : 23);
  texto(cuando, pad, y, fCab, GRIS);
  y += (ig ? 22 : 14) + tam * 0.86;
  for (const l of ls) { texto(l, pad - 3, y, `700 ${tam}px 'Bricolage Grotesque'`, TINTA); y += tam * 1.06; }
  y += (ig ? 30 : 20) - tam * 1.06 + tA * 0.82 + tam * 0.2;
  const wRaya = mide("— ", fAut);
  texto("— ", pad, y, fAut, GRIS);
  const wNom = texto(cita.autor, pad + wRaya, y, fAut, GRIS);
  if (falsa) { g.fillStyle = col; g.beginPath(); g.roundRect(pad + wRaya - 5, y - tA * 0.33, wNom + 10, ig ? 7 : 6, 3); g.fill(); }
  if (dosFilas) { y += tA * 1.15; texto(veredicto, pad, y, fVer, col); }
  else texto(veredicto, pad + wRaya + wNom + 24, y, fVer, col);

  let yc = y + tA * 0.18 + hueco;
  g.fillStyle = col + "14"; g.beginPath(); g.roundRect(pad, yc, ancho, altoCaja, 14); g.fill();
  let yt = yc + pC + (ig ? 29 : 19);
  texto(rotulo, pad + pC, yt, fRot, col);
  for (const l of cuerpo) { yt += lhC; texto(l, pad + pC, yt, fCaja, TINTA); }

  const fNota = `600 ${ig ? 30 : 21}px 'Familjen Grotesk'`, fDom = `500 ${ig ? 30 : 21}px 'Familjen Grotesk'`;
  const der = W - pad, yB = H - banda / 2 + 8;
  g.textAlign = "right";
  if (ig) { texto(nota, der, yB - 22, fNota, TINTA); texto("datos.mati.lol/picasso", der, yB + 22, fDom, GRIS); }
  else { const wd = texto("datos.mati.lol/picasso", der, yB, fDom, GRIS); texto(nota, der - wd - 32, yB, fNota, TINTA); }
  g.textAlign = "left";

  tarjetaBlob = await new Promise((r) => c.toBlob(r, "image/png"));
  const img = $("tarjeta");
  if (img.src) URL.revokeObjectURL(img.src);
  img.src = URL.createObjectURL(tarjetaBlob);
  img.alt = `Tarjeta: «${cita.frase}», según Milei de ${cita.autor}. ${ETIQUETA[cita.veredicto]}.`;
}
function abrir(c) { cita = c; $("dialogo").showModal(); dibujar(); }
function elegirFormato(f) {
  formato = f;
  for (const t of document.querySelectorAll(".tabs button")) t.setAttribute("aria-selected", t.dataset.formato === f);
  dibujar();
}
for (const t of document.querySelectorAll(".tabs button")) t.addEventListener("click", () => elegirFormato(t.dataset.formato));
$("cerrar").addEventListener("click", () => $("dialogo").close());
$("dialogo").addEventListener("click", (e) => { if (e.target === $("dialogo")) $("dialogo").close(); });
$("bajar").addEventListener("click", async () => {
  const nombre = `lo-dijo-${cita.id}-${formato}.png`;
  const file = new File([tarjetaBlob], nombre, { type: "image/png" });
  const url = "https://datos.mati.lol/picasso#" + cita.id;
  if (navigator.canShare?.({ files: [file] })) {
    try { await navigator.share({ files: [file], text: `«${cita.frase}» Milei se la atribuyó a ${cita.autor}. ${ETIQUETA[cita.veredicto]}. ${url}` }); return; } catch (e) { if (e.name === "AbortError") return; }
  }
  const a = document.createElement("a"); a.href = URL.createObjectURL(tarjetaBlob); a.download = nombre; a.click();
});
if (!navigator.canShare) $("bajar").textContent = "Descargar imagen";

// shared links point at one quote
const marcado = $(location.hash.slice(1));
if (marcado) { marcado.classList.add("marcada"); marcado.scrollIntoView({ block: "center" }); }
</script>

<style is:global>
:root { --fondo: #F3F3F1; --tinta: #15171C; --gris: #5E626B; --linea: #DCDDD9; --tenue: #A4A7AE; --rojo: #C2410C; --ambar: #A16207; --verde: #3F6212; --celeste: #2F7DC4; }
@media (prefers-color-scheme: dark) {
  :root { --fondo: #121419; --tinta: #EEEFF2; --gris: #A4A8B1; --linea: #262A32; --tenue: #5E636D; --rojo: #FB8B5A; --ambar: #E3B341; --verde: #A3C76D; --celeste: #6FB0EA; }
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body { margin: 0; background: var(--fondo); color: var(--tinta); font: 17px/1.5 "Familjen Grotesk", system-ui, sans-serif; font-variant-numeric: tabular-nums; }
main { max-width: 1240px; margin: 0 auto; padding: 0 16px 96px; display: grid; grid-template-columns: minmax(300px, 0.85fr) 1.5fr; column-gap: 56px; align-items: start; }
h1, h2, p, blockquote { margin: 0; }
a { color: inherit; text-underline-offset: 3px; }
button { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--celeste); outline-offset: 2px; }

header { position: sticky; top: 0; padding: 40px 0; }
h1 { font-family: "Bricolage Grotesque", sans-serif; font-weight: 600; font-size: clamp(24px, 4vw, 36px); line-height: 1.1; }
.no { font-family: "Bricolage Grotesque", sans-serif; font-weight: 800; font-size: clamp(110px, 14vw, 200px); line-height: 0.8; letter-spacing: -0.05em; margin: 18px 0 0 -0.04em; }
.titular { margin-top: 22px; font-family: "Bricolage Grotesque", sans-serif; font-weight: 500; font-size: clamp(20px, 2.4vw, 26px); line-height: 1.2; max-width: 24ch; }
.titular b { font-weight: 800; color: var(--rojo); }
.filtros { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 6px; }
.filtros button { border: 1px solid var(--linea); background: none; border-radius: 999px; padding: 6px 12px; font-size: 15px; cursor: pointer; }
.filtros button b { font-weight: 700; margin-left: 4px; }
.filtros button[aria-pressed="true"] { background: var(--tinta); color: var(--fondo); border-color: var(--tinta); }

#lista { list-style: none; margin: 0; padding: 40px 0 0; }
.cita { border-top: 1px solid var(--linea); padding: 22px 0; display: grid; gap: 8px; scroll-margin-top: 80px; }
.cita.marcada blockquote { color: var(--celeste); }
.cita blockquote { font-family: "Bricolage Grotesque", sans-serif; font-weight: 600; font-size: 22px; line-height: 1.25; max-width: 40ch; }
.cita .quien { font-size: 15px; color: var(--gris); }
.cita .quien b { color: var(--tinta); font-weight: 600; }
.fila { display: flex; align-items: center; justify-content: space-between; gap: 12px; max-width: 60ch; }
.veredicto { display: inline-flex; align-items: baseline; gap: 8px; font-weight: 700; font-size: 15px; }
.veredicto::before { content: ""; width: 10px; height: 10px; border-radius: 50%; background: currentColor; align-self: center; }
.v-no { color: var(--rojo); } .v-sin { color: var(--ambar); } .v-par { color: var(--ambar); } .v-si { color: var(--verde); }
.compartir { border: 1px solid var(--linea); background: none; border-radius: 999px; padding: 4px 12px; font-size: 14px; font-weight: 600; cursor: pointer; color: var(--gris); }
.compartir:hover { color: var(--tinta); border-color: var(--tinta); }
.explica { font-size: 15px; color: var(--gris); max-width: 60ch; }
.explica a { color: var(--gris); }
.usos { display: flex; flex-wrap: wrap; gap: 4px 10px; font-size: 13px; color: var(--tenue); }
.usos a { color: var(--gris); }
.cita.picasso blockquote { font-size: 28px; }
.origen { display: flex; gap: 14px; align-items: flex-start; max-width: 60ch; margin-top: 4px; padding: 12px 14px; border-radius: 10px; background: color-mix(in srgb, var(--rojo) 7%, transparent); font-size: 15px; line-height: 1.45; }
.origen b { font-weight: 700; color: var(--rojo); }
.origen img { display: block; width: 104px; height: 104px; object-fit: cover; border-radius: 6px; flex: none; }
.origen a { color: var(--tinta); }

footer { grid-column: 2; margin-top: 56px; padding-top: 16px; border-top: 1px solid var(--linea); font-size: 14px; color: var(--gris); display: grid; gap: 10px; max-width: 68ch; }
footer h2 { font-family: "Bricolage Grotesque", sans-serif; font-size: 18px; color: var(--tinta); }

dialog { border: 0; border-radius: 16px; padding: 18px; width: min(560px, calc(100vw - 24px)); max-height: calc(100dvh - 24px); background: var(--fondo); color: var(--tinta); box-shadow: 0 20px 60px rgba(0,0,0,.35); }
dialog::backdrop { background: rgba(10,12,16,.6); }
.tabs { display: flex; gap: 4px; padding: 4px; border-radius: 10px; background: var(--linea); }
.tabs button { flex: 1; border: 0; background: none; border-radius: 7px; padding: 8px; font-weight: 600; font-size: 15px; cursor: pointer; color: var(--gris); }
.tabs button[aria-selected="true"] { background: var(--fondo); color: var(--tinta); box-shadow: 0 1px 3px rgba(0,0,0,.15); }
.tabs small { font-weight: 400; margin-left: 4px; }
dialog img { display: block; width: 100%; max-height: 62dvh; object-fit: contain; margin: 14px 0; border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,.12); }
.acciones { display: flex; gap: 8px; }
.acciones button { flex: 1; border: 0; border-radius: 10px; padding: 12px; font-weight: 600; font-size: 15px; cursor: pointer; }
.acciones .principal { background: var(--tinta); color: var(--fondo); }
.acciones .secundario { background: var(--linea); color: var(--tinta); }

@media (max-width: 860px) {
  main { grid-template-columns: minmax(0, 1fr); }
  header { position: static; padding: 28px 0 0; }
  .no { font-size: 120px; }
  #lista { padding-top: 24px; }
  .filtros { padding: 10px 16px; margin: 18px -16px 0; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
  .filtros button { flex: none; }
  .cita blockquote { font-size: 20px; }
  .cita.picasso blockquote { font-size: 24px; }
  footer { grid-column: 1; }
}
</style>
