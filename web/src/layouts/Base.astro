---
// Every page uses this layout. It looks the page up in src/sitio.ts (and
// fails the build if it is missing), so title, description and the Open
// Graph image are always set.
import { CF_BEACON_TOKEN } from "../analytics";
import { ogSlug, pagina, SITIO } from "../sitio";

const p = pagina(Astro.url.pathname);
const url = new URL(p.path, SITIO.url).href;
const og = `${SITIO.url}/og/${ogSlug(p.path)}.png`;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{p.titulo}</title>
    <meta name="description" content={p.descripcion} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={p.titulo} />
    <meta property="og:description" content={p.descripcion} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={p.titulo} />
    <meta name="twitter:description" content={p.descripcion} />
    <meta name="twitter:image" content={og} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><text x='2' y='26' font-size='28' font-family='sans-serif' font-weight='800'>0</text></svg>" />
    <slot name="head" />
  </head>
  <body>
    <slot />
    {CF_BEACON_TOKEN && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: CF_BEACON_TOKEN })}></script>
    )}
  </body>
</html>
